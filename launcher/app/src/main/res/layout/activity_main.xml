<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <com.gathin.tvhome.BackdropView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

<com.gathin.tvhome.CenteringScrollView
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="26dp"
        android:paddingBottom="40dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Exactly one screen tall (set in code): clock, top bar and favourites only. -->
        <LinearLayout
            android:id="@+id/firstScreen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/greeting"
                            android:shadowColor="#B3000000"
                            android:shadowRadius="8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:textColor="#8CFFFFFF"
                            android:textSize="12sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:letterSpacing="0.22"
                            android:textAllCaps="true" />

                        <!-- Current temperature and sky, e.g. "61°  ☀️". -->
                        <TextView
                            android:id="@+id/weather"
                            android:shadowColor="#B3000000"
                            android:shadowRadius="8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:textColor="#CCFFFFFF"
                            android:textSize="12sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:letterSpacing="0.08" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="true">

                        <TextClock
                        android:shadowColor="#B3000000"
                        android:shadowRadius="8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:format12Hour="h:mm"
                            android:format24Hour="HH:mm"
                            android:textColor="#FFFFFFFF"
                            android:textSize="52sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 300"
                            android:letterSpacing="-0.04"
                            android:includeFontPadding="false" />

                        <TextClock
                        android:shadowColor="#B3000000"
                        android:shadowRadius="8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_gravity="bottom"
                            android:layout_marginBottom="8dp"
                            android:format12Hour="a"
                            android:format24Hour=""
                            android:textColor="#B3FFFFFF"
                            android:textSize="15sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:letterSpacing="0.08"
                            android:textAllCaps="true" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="26dp"
                            android:layout_gravity="bottom"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="16dp"
                            android:layout_marginBottom="8dp"
                            android:background="#33FFFFFF" />

                        <TextClock
                        android:shadowColor="#B3000000"
                        android:shadowRadius="8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:layout_marginBottom="9dp"
                            android:format12Hour="EEE  d MMM"
                            android:format24Hour="EEE  d MMM"
                            android:textColor="#A6FFFFFF"
                            android:textSize="14sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 400"
                            android:letterSpacing="0.14"
                            android:textAllCaps="true" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/topRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnSearch"
                        style="@style/IconButton"
                        android:src="@drawable/ic_search"
                        android:contentDescription="@string/search" />

                    <ImageView
                        android:id="@+id/btnPicture"
                        style="@style/IconButton"
                        android:src="@drawable/ic_picture"
                        android:contentDescription="@string/picture" />

                    <include layout="@layout/now_playing" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Pushes the favourites to the bottom of the first screen; the painting shows here. -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Above the favourites, right-aligned: today's game (game days only), then the painting's label. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="14dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/gameLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:background="@drawable/glass_dark"
                    android:focusable="true"
                    android:clickable="true"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/gameTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:duplicateParentState="true"
                        android:textColor="@drawable/pill_text"
                        android:textSize="15sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 500" />

                    <TextView
                        android:id="@+id/gameDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:singleLine="true"
                        android:duplicateParentState="true"
                        android:alpha="0.9"
                        android:textColor="@drawable/pill_text"
                        android:textSize="12sp"
                        android:fontFamily="@font/outfit"
                        android:letterSpacing="0.04" />
                </LinearLayout>

                <!-- Credit for the painting, styled like a museum wall label. -->
                <LinearLayout
                    android:id="@+id/artLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:background="@drawable/placard_bg"
                    android:orientation="horizontal"
                    android:visibility="invisible">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/artTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="440dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="#FFFFFFFF"
                            android:textSize="15sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
     />

                        <TextView
                            android:id="@+id/artByline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:maxWidth="440dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="#E6FFFFFF"
                            android:textSize="12sp"
                            android:fontFamily="@font/outfit"
                            android:letterSpacing="0.04"
     />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/front"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never" />
        </LinearLayout>

        <TextView style="@style/SectionLabel" android:text="@string/more" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tier"
            style="@style/TileRow" />

        <TextView style="@style/SectionLabel" android:text="@string/inputs" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/inputs"
            style="@style/TileRow" />

        <TextView
            android:id="@+id/btnAllApps"
            style="@style/TopButton"
            android:background="@drawable/glass_dark"
            android:layout_marginStart="8dp"
            android:layout_marginTop="22dp"
            android:text="@string/all_apps" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/allApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never" />
    </LinearLayout>
</com.gathin.tvhome.CenteringScrollView>

</FrameLayout>
